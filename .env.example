# --- Humanitix ---
# Account > Advanced > Public API key
HUMANITIX_API_KEY=

# Comma-separated list of Humanitix event IDs to sync.
# Find these in the URL: console.humanitix.com/console/my-events/{eventID}
HUMANITIX_EVENT_IDS=

# --- Mailchimp ---
# Account > Extras > API keys. Looks like abc123...-us21 (the "us21" part is your server prefix)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
# Audience/List ID: Audience > Settings > Audience name and defaults
MAILCHIMP_LIST_ID=

# What status new (non-existing) contacts get in Mailchimp.
# "subscribed" = immediately marketable (only use if your checkout question
#   already captured clear marketing consent).
# "pending"    = triggers Mailchimp's double opt-in confirmation email.
MAILCHIMP_STATUS_IF_NEW=subscribed
